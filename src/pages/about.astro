---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { url } from '../lib/url';
const about = site.about;
---
<Base title="Our story" description={about.intro}>
  <section class="section wrap about-intro"><p class="eyebrow">{about.eyebrow}</p><h1 aria-label={about.title.join(" ")}>{about.title.map(line => <span aria-hidden="true">{line}</span>)}</h1><p class="lede">{about.intro}</p></section>
  <section class="section wrap about-section"><p class="eyebrow">Why we go</p><div><h2>{site.home.storyTitle}</h2><p class="lede">{site.home.storyBody}</p><p>{site.home.memoryBody}</p></div></section>
  <section class="section wrap about-section"><p class="eyebrow">Friends on bikes</p><div><h2>{about.peopleTitle}</h2><p>{about.peopleText}</p><ul class="team">{site.team.map(member => <li>{member.name}</li>)}</ul></div></section>
  <section class="section wrap about-section"><p class="eyebrow">For years to come</p><div><h2>{about.journalTitle}</h2><p class="lede">{about.journalText}</p><a class="text-link" href={url('/trips')}>Open the journal <span aria-hidden="true">↗</span></a></div></section>
</Base>
<style>
  .about-intro h1 { margin-block: 2rem; }
  h1 span { display: block; }
  .about-intro .lede { max-width: 43ch; color: var(--ink-soft); }
  .about-section { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; }
  .about-section h2 { max-width: 15ch; }
  .about-section p:not(.eyebrow) { color: var(--ink-soft); }
  .about-section .lede { margin-block: 1.5rem; }
  .team { list-style: none; padding: 0; margin: 2.5rem 0 0; }
  .team li { padding-block: 1.25rem; border-top: 1px solid var(--line); font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 3vw, 2.5rem); letter-spacing: -0.03em; }
  .team li:last-child { border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) { .about-section { grid-template-columns: 1fr; gap: 1rem; } }
</style>
