---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TripCard from '../../components/TripCard.astro';
import Globe from '../../components/Globe.astro';
import { url } from '../../lib/url';
const trips = (await getCollection('trips', ({ data }) => !data.draft)).sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const years = [...new Set(trips.map((t) => t.data.start.getFullYear()))];
---
<Base title="The trip journal" description="Our bikepacking trips, kept here to come back to. Stories, films, routes and the days in between.">
  <section class="wrap globe-section" aria-labelledby="trips-title">
    <div class="archive-head">
      <div><p class="eyebrow">Outdo · The trip journal</p><h1 id="trips-title">A world of<br />good days.</h1></div>
      <div class="archive-intro"><p class="lede">The places we went. The days we still talk about. Pick a route and come along.</p><a class="text-link" href={url('/trips#stories')}>Go straight to the stories <span aria-hidden="true">↓</span></a></div>
    </div>
    <Globe trips={trips} />
  </section>
  <section class="section wrap archive" id="stories" aria-labelledby="stories-title">
    <div class="stories-head"><p class="eyebrow">From the journal</p><h2 id="stories-title">The long version.</h2></div>
    {years.map((year) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <div class="year-label"><h2 id={`year-${year}`}>{year}</h2><span aria-hidden="true">↘</span></div>
        <div class="grid">{trips.filter((trip) => trip.data.start.getFullYear() === year).map((trip) => <TripCard trip={trip} />)}</div>
      </section>
    ))}
    {trips.length === 0 && <p>The journal is just getting started. More stories soon.</p>}
  </section>
</Base>
<style>
  .globe-section { padding-block: clamp(3rem, 5vw, 5rem) 4rem; }
  .archive-head { display: grid; grid-template-columns: 1.2fr 1fr; align-items: end; gap: 3rem; padding-bottom: 2.5rem; }
  .archive-head .eyebrow { margin-bottom: 1.25rem; }
  h1 { font-size: clamp(3.5rem, 6.5vw, 6.5rem); margin-bottom: 0; }
  .archive-intro { max-width: 32rem; justify-self: end; padding-bottom: 0.4rem; }
  .lede { color: var(--ink-soft); }
  .archive { border-top: 1px solid var(--line); }
  .stories-head { margin-bottom: 3rem; }
  .year { display: grid; grid-template-columns: 1fr 3fr; gap: 3rem; border-top: 1px solid var(--line); padding-block: 3rem; }
  .year-label { display: flex; align-items: start; gap: 2rem; }
  .year-label h2 { font-size: 2rem; }
  .year-label span { font-size: 1.5rem; }
  .grid { display: grid; gap: 3rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid > :only-child { grid-column: 1 / -1; }
  @media (max-width: 760px) { .archive-head { grid-template-columns: 1fr; gap: 1.25rem; padding-bottom: 1rem; } .archive-intro { justify-self: start; } .archive-intro .lede { font-size: 1rem; margin-bottom: 0.75rem; } .year { grid-template-columns: 1fr; gap: 1rem; padding-block: 2rem; } .year-label { justify-content: space-between; } .grid { grid-template-columns: 1fr; } }
</style>
