---
import { url } from '../lib/url';
interface Slide {
  id: string;
  title: string;
  place: string;
  cover: string;
  coverAlt: string;
  href?: string;
  date?: string;
  film?: string;
}
interface Props { slides: Slide[] }
const { slides } = Astro.props;
---
<outdo-carousel role="region" aria-roledescription="carousel" aria-label="Trip journal">
  <div class="carousel-track" tabindex="0" aria-label="Trips. Use left and right arrow keys to explore.">
    {slides.map((slide, index) => (
      <article class="trip-slide" id={`journal-slide-${slide.id}`} role="group" aria-roledescription="slide" aria-label={`${slide.title}, ${index + 1} of ${slides.length}`}>
        <div class="trip-image">
          {slide.href
            ? <a href={url(slide.href)} aria-label={`Open ${slide.title}`}><img src={url(slide.cover)} alt={slide.coverAlt} loading="lazy" /><span class="image-link" aria-hidden="true">Step inside <span>↗</span></span></a>
            : <img src={url(slide.cover)} alt={slide.coverAlt} loading="lazy" />}
        </div>
        <div class="trip-copy">
          <p class="meta">{slide.date ? `From the journal · ${slide.date}` : 'From our travels'}</p>
          <p class="trip-places">{slide.place}</p>
          <h3>{slide.href ? <a href={url(slide.href)}>{slide.title}</a> : slide.title}</h3>
          {slide.href
            ? <a class="text-link" href={url(slide.href)}>Read the story <span aria-hidden="true">↗</span></a>
            : <p class="coming-soon">Story to come</p>}
          {slide.film && <a class="film-link" href={slide.film}>▷ Watch the film</a>}
        </div>
      </article>
    ))}
  </div>
  <div class="carousel-controls" hidden>
    <div class="trip-selectors" role="group" aria-label="Choose a trip">
      {slides.map((slide, index) => <button type="button" class="trip-selector" data-index={index} aria-controls={`journal-slide-${slide.id}`} aria-pressed={index === 0 ? 'true' : 'false'}>{slide.title}</button>)}
    </div>
    <div class="carousel-arrows"><button class="previous" type="button" aria-label="Previous trip"><span aria-hidden="true">←</span></button><button class="next" type="button" aria-label="Next trip"><span aria-hidden="true">→</span></button></div>
  </div>
  <p class="sr-only carousel-status" role="status" aria-live="polite" aria-atomic="true"></p>
</outdo-carousel>
<script>
  class OutdoCarousel extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      if (this.cleanup) return;
      const track = this.querySelector<HTMLElement>('.carousel-track');
      const slides = Array.from(this.querySelectorAll<HTMLElement>('.trip-slide'));
      const selectors = Array.from(this.querySelectorAll<HTMLButtonElement>('.trip-selector'));
      const controls = this.querySelector<HTMLElement>('.carousel-controls');
      const previous = this.querySelector<HTMLButtonElement>('.previous');
      const next = this.querySelector<HTMLButtonElement>('.next');
      const status = this.querySelector('.carousel-status');
      if (!track || !slides.length || !controls || !previous || !next) return;
      let current = 0;
      let frame = 0;
      const events = new AbortController();
      const options = { signal: events.signal };
      const select = (index: number, announce = true) => {
        current = index;
        slides.forEach((slide, i) => { slide.inert = i !== current; slide.setAttribute('aria-hidden', String(i !== current)); });
        selectors.forEach((button, i) => button.setAttribute('aria-pressed', String(i === current)));
        previous.disabled = current === 0;
        next.disabled = current === slides.length - 1;
        if (announce && status) status.textContent = slides[current].getAttribute('aria-label');
      };
      const goTo = (index: number) => {
        const target = Math.min(slides.length - 1, Math.max(0, index));
        select(target);
        track.scrollTo({ left: slides[target].offsetLeft, behavior: 'auto' });
      };
      const onScroll = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          let nearest = 0;
          slides.forEach((slide, i) => {
            if (Math.abs(slide.offsetLeft - track.scrollLeft) < Math.abs(slides[nearest].offsetLeft - track.scrollLeft)) nearest = i;
          });
          if (nearest !== current) select(nearest);
        });
      };
      previous.addEventListener('click', () => goTo(current - 1), options);
      next.addEventListener('click', () => goTo(current + 1), options);
      selectors.forEach((button, index) => button.addEventListener('click', () => goTo(index), options));
      track.addEventListener('scroll', onScroll, { ...options, passive: true });
      track.addEventListener('keydown', (event) => {
        if (event.target !== track || event.altKey || event.ctrlKey || event.metaKey) return;
        const targets: Record<string, number> = { ArrowLeft: current - 1, ArrowRight: current + 1, Home: 0, End: slides.length - 1 };
        if (!(event.key in targets)) return;
        event.preventDefault();
        goTo(targets[event.key]);
      }, options);
      const resize = new ResizeObserver(() => track.scrollTo({ left: slides[current].offsetLeft, behavior: 'auto' }));
      resize.observe(track);
      select(0, false);
      controls.hidden = slides.length < 2;
      this.classList.add('enhanced');
      this.cleanup = () => { events.abort(); resize.disconnect(); cancelAnimationFrame(frame); this.cleanup = undefined; };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('outdo-carousel')) customElements.define('outdo-carousel', OutdoCarousel);
</script>
<style>
  outdo-carousel { display: block; min-width: 0; }
  .carousel-track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; gap: 2rem; position: relative; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; scroll-behavior: auto; }
  .enhanced .carousel-track { scrollbar-width: none; }
  .enhanced .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track:focus-visible { outline-offset: 8px; }
  .trip-slide { min-width: 0; display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; scroll-snap-align: start; scroll-snap-stop: always; }
  .trip-image { align-self: stretch; position: relative; background: var(--line); min-width: 0; }
  .trip-image a { display: block; height: 100%; overflow: hidden; }
  .trip-image img { width: 100%; height: 100%; min-height: 420px; aspect-ratio: 1.2; object-fit: cover; }
  .trip-image a img { transition: transform 350ms ease; }
  .trip-image a:hover img { transform: scale(1.025); }
  .image-link { position: absolute; bottom: 1.25rem; right: 1.25rem; display: flex; gap: 2rem; background: var(--stone); color: var(--ink); padding: 0.6rem 1rem; font-size: 0.8rem; }
  .trip-copy { min-width: 0; padding-block: 1rem; padding-right: 0.5rem; }
  .trip-copy > .meta { margin-bottom: 2.5rem; }
  .trip-places { font-size: 0.75rem; color: var(--ink-soft); margin-bottom: 1rem; }
  h3 { font-size: clamp(2.6rem, 4.2vw, 4.25rem); max-width: 12ch; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--lake); }
  .film-link { display: block; margin-top: 1.25rem; font-size: 0.85rem; color: var(--ink-soft); text-decoration: none; }
  .film-link:hover { color: var(--lake); }
  .coming-soon { display: inline-block; font-size: 0.85rem; color: var(--ink-soft); margin: 1.5rem 0 0; padding-block: 0.6rem; border-bottom: 1px solid var(--line); }
  .carousel-controls { display: flex; justify-content: space-between; align-items: center; gap: 3rem; margin-top: 2rem; }
  .carousel-controls[hidden] { display: none; }
  .trip-selectors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); flex: 1; gap: 1.5rem; }
  .trip-selector { background: transparent; border: 0; border-top: 2px solid var(--line); color: var(--ink-soft); padding: 1rem 0 0.5rem; min-height: 44px; text-align: left; font-size: 0.9rem; line-height: 1.4; }
  .trip-selector[aria-pressed='true'] { border-color: var(--lake); color: var(--ink); }
  .trip-selector:hover { color: var(--lake); }
  .carousel-arrows { display: flex; gap: 0.6rem; }
  .carousel-arrows button { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--ink); color: var(--ink); background: transparent; font-size: 1.3rem; }
  .carousel-arrows button:hover:not(:disabled) { color: var(--stone); background: var(--ink); }
  .carousel-arrows button:disabled { opacity: 0.3; cursor: default; }
  @media (max-width: 760px) {
    .trip-slide { grid-template-columns: 1fr; grid-template-rows: auto 1fr; align-items: start; gap: 1.5rem; }
    .trip-image { align-self: start; }
    .trip-image img { min-height: 0; height: auto; aspect-ratio: 4 / 3; }
    .trip-copy { padding-block: 0; }
    .trip-copy > .meta { margin-bottom: 1.5rem; }
    h3 { max-width: 13ch; }
    .carousel-controls { flex-direction: column; align-items: stretch; gap: 1rem; }
    .trip-selectors { gap: 0.75rem; }
    .trip-selector { font-size: 0.75rem; }
    .carousel-arrows { justify-content: end; }
  }
</style>
