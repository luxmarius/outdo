---
import Scene from './Scene.astro';
import { formatDateRange } from '../lib/format';
interface Props {
  eyebrow?: string;
  title: string;
  tagline: string;
  cover: string;
  heroVideo?: string;
  start: Date;
  end: Date;
  countries: string[];
  cta?: { href: string; label: string };
  secondary?: { href: string; label: string };
  size?: 'full' | 'tall';
}
const { eyebrow, title, tagline, cover, heroVideo, start, end, countries, cta, secondary, size = 'full' } = Astro.props;
---
<section class:list={['hero', size]}>
  <Scene cover={cover} video={heroVideo} />
  <div class="shade" aria-hidden="true"></div>
  <div class="wrap content">
    <p class="eyebrow">{eyebrow ?? 'From the trip journal'} <span>·</span> {formatDateRange(start, end)}</p>
    <h1>{title}</h1>
    <div class="hero-bottom">
      <div><p class="tagline">{tagline}</p><p class="facts">{countries.join(' / ')}</p></div>
      {(cta || secondary) && <div class="actions">
        {cta && <a class="button light" href={cta.href}>{cta.label} <span aria-hidden="true">↗</span></a>}
        {secondary && <a class="text-link" href={secondary.href} rel="noopener">{secondary.label}</a>}
      </div>}
    </div>
  </div>
</section>
<style>
  .hero { position: relative; isolation: isolate; color: var(--on-dark); display: grid; align-items: end; min-height: 100svh; background: var(--pine); }
  .hero.tall { min-height: 88svh; }
  .shade { position: absolute; inset: 0; z-index: -1; background: var(--shade); }
  .content { padding-block: 14rem 3.5rem; }
  .eyebrow { margin-bottom: 1.75rem; }
  .eyebrow span { margin-inline: 0.4rem; }
  h1 { font-size: clamp(3.5rem, 9vw, 9rem); max-width: 12ch; margin-bottom: 2rem; letter-spacing: -0.025em; }
  .hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .tagline { max-width: 45ch; font-size: clamp(1.1rem, 1.6vw, 1.4rem); line-height: 1.5; }
  .facts { color: var(--on-dark-soft); font-size: 0.8rem; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; }
  .text-link { white-space: nowrap; }
  .text-link:hover { color: var(--white); }
  @media (max-width: 760px) { .hero-bottom { flex-direction: column; align-items: start; } .content { padding-bottom: 2.5rem; } .eyebrow { max-width: 27ch; font-size: 0.8rem; } }
</style>
