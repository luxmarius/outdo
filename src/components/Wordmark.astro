---
import site from '../data/site.json';
import { url } from '../lib/url';
---
<a class="wordmark" href={url('/')} aria-label={`${site.name} home`}>{site.name}<span class="wordmark-dot" aria-hidden="true">.</span></a>
<style>
  .wordmark { color: inherit; text-decoration: none; font-family: var(--font-display); font-size: var(--wordmark-size, 2.5rem); font-weight: 800; letter-spacing: var(--brand-tracking); line-height: 1; white-space: nowrap; }
  .wordmark-dot { color: var(--lake); }
</style>
