---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <p>{it.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); max-width: 720px; }
  details { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none; padding: 1.25rem 0; font-family: var(--font-display); font-size: 1.45rem; line-height: 1.2;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-family: var(--font-body); font-weight: 400; font-size: 1.4rem; color: var(--moss); }
  details[open] summary::after { content: '–'; }
  details p { margin: 0 0 1.5rem; color: var(--ink-soft); }
</style>
