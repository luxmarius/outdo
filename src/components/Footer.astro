---
import site from '../data/site.json';
import Wordmark from './Wordmark.astro';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-brand"><Wordmark /><p>Friends on bikes. Stories for years.</p></div>
      <div class="footer-invite"><h2>{site.home.footerTitle}</h2><a class="text-link" href={`mailto:${site.email}`}>Say hello <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="footer-bottom"><span class="copy">© {year} {site.name}</span><nav aria-label="Footer"><a href={url('/trips')}>Trips</a><a href={url('/blog')}>Notes</a><a href={url('/about')}>About</a><a href={site.instagram} rel="noopener">Instagram ↗</a></nav></div>
  </div>
</footer>
<style>
  .footer { --wordmark-size: 2.5rem; background: var(--pine); color: var(--on-dark); padding-block: clamp(2.25rem, 4vw, 3.5rem) 1.5rem; }
  .footer-main { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-bottom: 2rem; }
  .footer-brand p { margin: 0.8rem 0 0; font-size: 0.85rem; color: var(--on-dark-soft); }
  .footer-invite { display: flex; align-items: center; gap: 2rem; }
  .footer-invite h2 { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .footer .text-link { font-size: 0.85rem; white-space: nowrap; }
  .footer .text-link:hover { color: var(--white); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line-dark); }
  nav { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.8rem; }
  nav a { color: inherit; text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .copy { color: var(--on-dark-soft); font-size: 0.75rem; white-space: nowrap; }
  @media (max-width: 760px) { .footer { --wordmark-size: 2.25rem; } .footer-main { align-items: start; flex-direction: column; gap: 1.5rem; } .footer-invite { width: 100%; justify-content: space-between; gap: 1rem; } .footer-bottom { align-items: start; flex-direction: column-reverse; gap: 1.25rem; } nav { gap: 1.25rem; } }
</style>
